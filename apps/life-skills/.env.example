# Copy only into a private runtime, never into Git or a packet.
# Locked by default. A preview contains no client data and is not a login portal.
LS_APP_MODE=foundation_locked
LS_APP_ORIGIN=http://127.0.0.1:3001
# For local-only synthetic rendering: LS_APP_MODE=foundation_preview
# Optional at app boot; required only by the corresponding database command.
LS_DATABASE_URL=
LS_MIGRATION_DATABASE_URL=
LS_DATABASE_TLS=verify-full
# Production remote DB uses a provider-trusted CA; custom PEM is optional, private.
LS_DATABASE_CA=
# Test DB is disposable and must be named with suffix _test. Never use real data.
LS_TEST_DATABASE_URL=

# Framework telemetry remains disabled in development and integration.
NEXT_TELEMETRY_DISABLED=1
