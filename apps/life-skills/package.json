{
  "name": "@life-skills/private-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config vitest.ui.config.ts && playwright test --config playwright.ui.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/migrate.ts --verify-only",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e:locked": "playwright test --config playwright.locked.config.ts"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "drizzle-orm": "0.45.2",
    "pg": "8.16.3",
    "zod": "4.5.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
